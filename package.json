{
  "name": "clipt",
  "version": "0.1.0",
  "private": true,
  "description": "Clipt monorepo — apps/web (Next.js) + workers/video (Python FastAPI)",
  "scripts": {
    "dev": "pnpm --filter @clipt/web dev",
    "build": "pnpm --filter @clipt/web build",
    "start": "pnpm --filter @clipt/web start",
    "lint": "pnpm --filter @clipt/web lint",
    "typecheck": "pnpm --filter @clipt/web typecheck",
    "format": "pnpm --filter @clipt/web format",
    "format:check": "pnpm --filter @clipt/web format:check",
    "inngest:dev": "pnpm --filter @clipt/web inngest:dev",
    "test": "pnpm --filter @clipt/web test",
    "test:watch": "pnpm --filter @clipt/web test:watch",
    "db:push": "node scripts/db.mjs push",
    "db:reset": "node scripts/db.mjs reset",
    "db:diff": "node scripts/db.mjs diff",
    "db:types": "node scripts/db.mjs types"
  },
  "devDependencies": {
    "jose": "^5.10.0",
    "supabase": "^2.98.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
}
