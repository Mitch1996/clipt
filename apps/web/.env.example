# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# postgresql://postgres.<ref>:<url-encoded-pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- Stripe ---
# Server-only secret + recurring-price IDs power Stripe Checkout for the
# Creator / Pro tiers. STRIPE_WEBHOOK_SECRET is filled in after registering
# https://<your-app>/api/stripe/webhook in Stripe's dashboard.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set INNGEST_DEV=1 in .env.local for local development. It points the
# SDK at the local dev server (127.0.0.1:8288) and skips signing-key auth
# on /api/inngest so the dev CLI's discovery probe can register functions.
# DO NOT set this in production.
# INNGEST_DEV=1

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Twitch OAuth ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# AES-256-GCM key for OAuth-token encryption at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Public origin used to build OAuth redirect URLs. Must match each
# provider's registered redirect URL exactly.
NEXT_PUBLIC_APP_URL=http://localhost:3006

# --- YouTube OAuth ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- TikTok OAuth (for posting to TikTok via Content Posting API) ---
# Register an app at developers.tiktok.com → app review required for
# production. Sandbox accounts can post without full audit.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Instagram OAuth (for posting Reels via Meta Graph API) ---
# Register a Meta app at developers.facebook.com. Posting Reels needs
# `instagram_content_publish` permission AND a Business / Creator
# Instagram account linked to a Facebook Page. Most onerous of the
# three — may require app review.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# --- AI ---
OPENAI_API_KEY=

# --- Email ---
RESEND_API_KEY=

# --- Attribution signing (ed25519, base64) ---
ATTRIBUTION_SIGNING_KEY=

# --- Fly.io (video worker deploys) ---
FLY_API_TOKEN=

# Public URL of the deployed video worker (e.g.
# https://clipt-video-worker.fly.dev). For local dev point at
# http://localhost:8000.
VIDEO_WORKER_URL=

# Shared HMAC secret used to sign worker requests; same value lives in
# .env.local on the Next side and as a Fly secret on the worker side.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WORKER_HMAC_KEY=

# Storage backend (S3-compatible). Used by:
#   - Next side via @aws-sdk/client-s3 (apps/web/src/lib/storage/r2.ts)
#   - Python worker via boto3 (workers/video/app/storage.py)
#
# Both pick up the same env contract. Leave STORAGE_ENDPOINT_URL empty
# for real AWS S3 (the SDKs auto-resolve the regional endpoint). Set
# it explicitly for S3-compatible backends like Cloudflare R2 (e.g.
# https://<account>.r2.cloudflarestorage.com) or Supabase Storage's S3
# endpoint (e.g. https://<project>.supabase.co/storage/v1/s3).
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=clipt-media
STORAGE_REGION=eu-north-1

# --- Upstash Redis (live ingestion) ---
# Used by the live-ingestion worker (workers/live, Phase 2.1) to
# track the head segment per live channel. Free tier covers 10k cmd/d.
# Create a database at https://console.upstash.com and pick a region
# close to the Fly region you're deploying the live worker to (ams).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private-preview gate. Set both to put HTTP Basic Auth in front of
# /auth/* and /dashboard/*. The public landing page (/) and clip pages
# (/c/*) stay open so Stripe + the waitlist still work. Leave both
# unset locally — production gate only.
SITE_GATE_USER=
SITE_GATE_PASSWORD=
