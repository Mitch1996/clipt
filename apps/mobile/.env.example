# Mobile-app env. Copy to .env.local before running `pnpm --filter
# @clipt/mobile start`. Expo reads anything prefixed with EXPO_PUBLIC_*
# and inlines it at build time, so these are baked into the JS bundle —
# never put service-role secrets here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Where the web app is deployed. The mobile auth callback deep-links
# back into the app via clipt://auth/callback, but the OAuth providers
# (Twitch, Google) initially redirect to the web origin's
# /api/oauth/...mobile-callback route which then 302s into the deep
# link. Set this to wherever you've deployed the web app.
EXPO_PUBLIC_APP_URL=https://clipt.live
