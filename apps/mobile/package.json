{
  "name": "@clipt/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "// node-options": "Node 24 enables experimental TS stripping by default, which breaks Expo's config loader when it tries to import expo-modules-core .ts source files from node_modules. --no-experimental-strip-types disables that.",
    "start": "cross-env NODE_OPTIONS=--no-experimental-strip-types expo start",
    "// start:tunnel": "Use this when the PC + phone aren't on the same LAN (PC on ethernet/VPN, phone on Wi-Fi). Routes through Expo's proxy. First run prompts to install @expo/ngrok — answer y.",
    "start:tunnel": "cross-env NODE_OPTIONS=--no-experimental-strip-types expo start --tunnel",
    "android": "cross-env NODE_OPTIONS=--no-experimental-strip-types expo start --android",
    "ios": "cross-env NODE_OPTIONS=--no-experimental-strip-types expo start --ios",
    "web": "cross-env NODE_OPTIONS=--no-experimental-strip-types expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "cross-env NODE_OPTIONS=--no-experimental-strip-types expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.17",
    "cross-env": "^7.0.3",
    "typescript": "~5.9.3"
  }
}
