# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# postgresql://postgres.<ref>:<url-encoded-pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Twitch OAuth ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# AES-256-GCM key for OAuth-token encryption at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Public origin used to build OAuth redirect URLs. Must match each
# provider's registered redirect URL exactly.
NEXT_PUBLIC_APP_URL=http://localhost:3006

# --- YouTube OAuth ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- AI ---
OPENAI_API_KEY=

# --- Email ---
RESEND_API_KEY=

# --- Attribution signing (ed25519, base64) ---
ATTRIBUTION_SIGNING_KEY=
